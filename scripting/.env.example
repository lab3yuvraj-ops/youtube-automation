# Add ONE writing-model key. If both are configured, the pipeline prefers OpenAI.
OPENAI_API_KEY=
GROQ_API_KEY=

# Optional publishing and music credentials. Keep all values local in .env.
ZERNIO_API_KEY=
# Connected YouTube account ID from Zernio, not your YouTube channel ID.
ZERNIO_YOUTUBE_ACCOUNT_ID=
# private for testing; change to public when ready.
YOUTUBE_VISIBILITY=private

# File paths: absolute paths or relative to the repository root.
# Use forward slashes on Windows, e.g. C:/Users/you/Videos/intro.mp4.
CHANNEL_LOGO_PATH=production/assets/channel-logo.png
CHANNEL_INTRO_PATH=production/assets/channel-intro.mp4

FREESOUND_CLIENT_ID=
FREESOUND_CLIENT_SECRET=
FREESOUND_REFRESH_TOKEN=

# Optional provider-specific model overrides.
# OPENAI_MODEL=gpt-4.1-mini
# GROQ_MODEL=openai/gpt-oss-120b
